# DEEP E-BIKE & TOY - Client Environment Configuration Example
#
# For Local Development (with Vite dev proxy):
# Leave empty or set to '/api' to route to http://localhost:5000/api
VITE_API_URL=/api

# For Production Hosting on Vercel:
# Set this in your Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://your-render-backend-service.onrender.com/api
