# DEEP E-BIKE & TOY POS Backend Environment Configuration Example
PORT=5000
NODE_ENV=production

# For Offline / Local Desktop Mode:
DATABASE_URL="file:./deep_pos.db"

# For Online Cloud PostgreSQL Mode (uncomment to use PostgreSQL):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/deep_pos_db?schema=public"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=7d

# Remote Cloud Sync Server Endpoint
REMOTE_API_URL=https://api.deepebikeandtoy.com/api
SYNC_INTERVAL_SECONDS=30
AUTO_SYNC_ENABLED=true

# Shop Details
SHOP_NAME=DEEP E-BIKE & TOY
SHOP_TAGLINE=Electric Bikes, Electric Scooters, Kids Ride-On & Toys
SHOP_ADDRESS=Shop No. 12-14, Green Park Main Road, City Center
SHOP_PHONE=+91 98765 43210
SHOP_EMAIL=contact@deepebikeandtoy.com
SHOP_GSTIN=27ABCDE1234F1Z5
