# ===================================================================
# DEEP E-BIKE & TOY POS - Backend Environment Configuration Example
# ===================================================================

# Server Port (Render dynamically assigns PORT in production)
PORT=5000
NODE_ENV=production

# -------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------
# Mode: "postgresql" for Render cloud production, "sqlite" for Electron local desktop
DATABASE_TYPE=postgresql

# For Offline / Local Desktop Mode (SQLite):
DATABASE_URL="file:./deep_pos.db"

# For Cloud Production on Render (Neon Serverless PostgreSQL):
# Paste your Neon connection string into Render Environment Variables:
NEON_DATABASE_URL="postgresql://user:password@ep-placeholder.neon.tech/neondb?sslmode=require"

# -------------------------------------------------------------------
# Security & Authentication
# -------------------------------------------------------------------
# Generate a secure 64-character random string for production:
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------------
# CORS Configuration (Vercel Frontend URL)
# -------------------------------------------------------------------
# Allowed origin(s) for CORS. In production, set to your Vercel URL:
FRONTEND_URL=https://your-frontend-service.vercel.app

# -------------------------------------------------------------------
# Sync & Edge Configuration
# -------------------------------------------------------------------
REMOTE_API_URL=https://your-backend-service.onrender.com/api
SYNC_INTERVAL_SECONDS=30
AUTO_SYNC_ENABLED=true

# -------------------------------------------------------------------
# Store Profile Defaults
# -------------------------------------------------------------------
SHOP_NAME=DEEP E-BIKE & TOY
SHOP_TAGLINE=Electric Bikes, Electric Scooters, Kids Ride-On & Toys
SHOP_ADDRESS=Shop No. 12-14, Green Park Main Road, City Center
SHOP_PHONE=+91 98765 43210
SHOP_EMAIL=contact@deepebikeandtoy.com
SHOP_GSTIN=27ABCDE1234F1Z5
